# ── Backend (funkcje /api na Vercel) ──────────────────────────────
# Skopiuj do .env (lokalnie) i/lub ustaw w Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# UWAGA: service_role key (NIE anon). Tylko po stronie serwera — nigdy w przeglądarce.
SUPABASE_SERVICE_KEY=eyJhbGciOi...service_role...

# Token dla CRUD API (dashboard wysyła go w nagłówku Authorization: Bearer <token>).
# Wygeneruj coś losowego, np.: openssl rand -hex 24
API_TOKEN=zmien-mnie-na-losowy-token

# Statyczny klucz dla publicznego /api/widget (?key=...). Osobny od API_TOKEN.
WIDGET_KEY=zmien-mnie-na-inny-losowy-klucz

# (opcjonalnie, na później) YouTube Data API v3 key — aktywuje /refresh-subs.
# Bez tego auto-suby są wyłączone (v1 ręczne).
# YOUTUBE_API_KEY=AIza...
