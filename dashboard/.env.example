# ── Dashboard (Vite) ──────────────────────────────────────────────
# Skopiuj do dashboard/.env.local

# Baza URL API. Na produkcji (dashboard + /api na tym samym projekcie Vercel)
# zostaw puste albo "/api" — wtedy zapytania idą same-origin.
# W dev z proxy Vite też zostaw "/api".
VITE_API_BASE=/api

# Token do CRUD API (musi = API_TOKEN z backendu).
# UWAGA: token trafia do bundla przeglądarki (dashboard hostujesz u siebie).
# W dev przez proxy Vite możesz zostawić puste i dodać token po stronie `vercel dev`.
VITE_API_TOKEN=zmien-mnie-na-losowy-token

# (dev, opcjonalnie) gdzie Vite proxuje /api, gdy backend stoi osobno
# VITE_DEV_API_TARGET=http://localhost:3000
